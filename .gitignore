# Private, local-only notes and drafts. Never committed, anywhere in the tree.
_local/

# Personal Claude Code settings (the shared file is .claude/settings.json)
.claude/settings.local.json

# Obsidian per-user state (settings are documented, not committed)
.obsidian/
.trash/

